# Optional. Without it the analysts return an evidence-only brief built by code.
ANTHROPIC_API_KEY=

# Optional. Vapi public (browser) key to enable live voice. Typed commands work without it.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Optional. Use an assistant configured in the Vapi dashboard instead of the built-in one.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Optional. Public URL of this deployment, if it differs from the request origin.
PUBLIC_BASE_URL=
